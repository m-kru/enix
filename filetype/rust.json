[
	{
		"Name": "Default",
		"Attribute": {
			"Regex": "\\b(const|mut|static)\\b"
		},
		"Keyword": {
			"Regex": "\\b(as|async|await|break|continue|crate|dyn|else|enum|extern|fn|for|if|impl|in|let|loop|match|mod|move|pub|ref|return|struct|super|trait|type|unsafe|use|where|while|abstract|become|box|do|final|gen|macro|override|priv|try|typeof|unsized|virtual|yield)\\b",
			"NegativeLookBehind": "#"
		},
		"Meta": {
			"Regex": "\\b\\w+!"
		},
		"Number": {
			"Regex": "\\b(?:0[xX][0-9a-fA-F_]*[0-9a-fA-F][0-9a-fA-F_]*(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize)?|0[oO][0-7_]*[0-7][0-7_]*(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize)?|0[bB][01_]*[01][01_]*(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize)?|[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?(?:f32|f64)?|[0-9][0-9_]*\\.|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*(?:f32|f64)?|[0-9][0-9_]*(?:f32|f64)|[0-9][0-9_]*(?:u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize)?)\\b"
		},
		"Operator": {
			"Regex": "=|\\+|-|>|<|\\*|/|&|%|!|\\||~|:|\\.\\.|\\^"
		},
		"String": {
			"Regex": "b?'.'"
		},
		"Type": {
			"Regex": "\\b(bool|char|str|isize|usize|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64)\\b"
		},
		"Value": {
			"Regex": "\\b(_|false|true|self|Self|None|Some|Ok|Err)\\b"
		},
		"Variable": {
			"Regex": "\\$\\w+"
		}
	},
	{
		"Name": "Block Comment",
		"Style": "Comment",
		"Start": {
			"Regex": "/\\*"
		},
		"End": {
			"Regex": "\\*/"
		},
		"Bold": {
			"Regex": "(?i)(todo|note|xxx):"
		}
	},
	{
		"Name": "Line Comment",
		"Style": "Comment",
		"Start": {
			"Regex": "//"
		},
		"End": {
			"Regex": "$"
		},
		"Bold": {
			"Regex": "(?i)(todo|note|xxx):"
		}
	},
	{
		"Name": "String",
		"Style": "String",
		"Start": {
			"Regex": "\""
		},
		"End": {
			"Regex": "\"",
			"NegativeLookBehind": "\\\\"
		},
		"Meta": {
			"Regex": "\\\\(a|b|e|f|n|r|t|v|\"|\\\\)"
		},
		"Value": {
			"Regex": "\\{[\\w|\\s|:|#|\\?]*\\}"
		},
		"Variable": {
			"Regex": "%(c|d|f|ld|lx|p[aBKxS]?|s|u|x)"
		}
	}
]
