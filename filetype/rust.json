[
	{
		"Name": "Default",
		"Keyword": {
			"Regex": "\\b(_|as|async|await|break|const|continue|crate|dyn|else|enum|extern|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|static|struct|super|trait|type|unsafe|use|where|while|abstract|become|box|do|final|gen|macro|override|priv|try|typeof|unsized|virtual|yield)\\b",
			"NegativeLookBehind": "#"
		},
		"Meta": {
			"Regex": "\\b\\w+!"
		},
		"Operator": {
			"Regex": "=|\\+|-|>|<|\\*|/|&|%|!|\\||~|::|\\.\\.|\\^"
		},
		"Type": {
			"Regex": "\\b(bool|Box|Option|Result|Vec|isize|usize|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128)|f32|f64\\b"
		},
		"Value": {
			"Regex": "\\b(false|true|self|Self|None|Some|Ok|Err)\\b"
		}
	},
	{
		"Name": "Block Comment",
		"Style": "Comment",
		"Start": {
			"Regex": "/\\*"
		},
		"End": {
			"Regex": "\\*/"
		},
		"Bold": {
			"Regex": "(?i)(todo|note|xxx):"
		}
	},
	{
		"Name": "Line Comment",
		"Style": "Comment",
		"Start": {
			"Regex": "//"
		},
		"End": {
			"Regex": "$"
		},
		"Bold": {
			"Regex": "(?i)(todo|note|xxx):"
		}
	},
	{
		"Name": "String",
		"Style": "String",
		"Start": {
			"Regex": "\""
		},
		"End": {
			"Regex": "\"",
			"NegativeLookBehind": "\\\\"
		},
		"Meta": {
			"Regex": "\\\\(a|b|e|f|n|r|t|v|\"|\\\\)"
		},
		"Value": {
			"Regex": "\\{[\\w|\\s|:|\\?]*\\}"
		},
		"Variable": {
			"Regex": "%(c|d|f|ld|lx|p[aBKxS]?|s|u|x)"
		}
	}
]
